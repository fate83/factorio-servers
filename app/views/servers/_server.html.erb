<div id="<%= dom_id server %>">
  <p class="my-5">
    <strong class="block font-medium mb-1">Title:</strong>
    <%= server.title %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Version:</strong>
    <%= server.version %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">State:</strong>
    <%= server.state %>
  </p>

</div>
