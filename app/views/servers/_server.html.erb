<div id="<%= dom_id server %>">
  <p class="my-5">
    <strong class="block font-medium mb-1">Title:</strong>
    <%= server.name %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Version:</strong>
    <%= server.version %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">State:</strong>
    <%= server.state %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Cloudserver-Name:</strong>
    <%= server.cloud_server_name %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Cloudserver-ID:</strong>
    <%= server.cloud_server_id %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Cloudserver-IP:</strong>
    <%= server.cloud_server_ip %>
  </p>

</div>
